# Copy to .env and replace all four secrets before starting.
# Use URL-safe random passwords (e.g. openssl rand -hex 32) for PostgreSQL.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
REGISTRY_HTTP_SECRET=replace-with-a-random-secret-at-least-32-characters
REGISTRY_WEBHOOK_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Tag used for the three locally built Dockyard images: init, migrate, and web.
DOCKYARD_IMAGE_TAG=local

# One public origin for the browser, Docker CLI, and token exchange. No trailing slash.
APP_URL=http://localhost:3000
DEFAULT_REPOSITORY_VISIBILITY=public

# Only ingress publishes a port. Update APP_URL too if you change this port/hostname.
INGRESS_BIND_ADDRESS=0.0.0.0
INGRESS_PORT=3000

# Optional HTTPS override: uncomment and point this domain at the server.
# DOCKYARD_DOMAIN=dockyard.example.com

# Local development only (pnpm dev); Compose supplies its own internal URLs.
DATABASE_URL=postgres://dockyard:replace-with-a-random-url-safe-password@localhost:5432/dockyard
REGISTRY_INTERNAL_URL=http://localhost:5000
# For separate local development services only; Compose derives this from APP_URL.
# REGISTRY_PUBLIC_HOST=localhost:5000
REGISTRY_TOKEN_KEY_PATH=.certs/token.key
REGISTRY_TOKEN_CERT_PATH=.certs/token.crt
